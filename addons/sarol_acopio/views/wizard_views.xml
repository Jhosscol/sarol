<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sarol_pago_generar_view_form" model="ir.ui.view">
        <field name="name">sarol.pago.generar.form</field>
        <field name="model">sarol.pago.generar</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="semana_inicio"/>
                </group>
                <footer>
                    <button name="action_generar" string="Generar pagos" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sarol_pago_generar_action" model="ir.actions.act_window">
        <field name="name">Generar pagos de la semana</field>
        <field name="res_model">sarol.pago.generar</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
